{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    /* JSX */
    "jsx": "react-native",

    /* Type Safety */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Module Resolution (FIX) */
    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* Performance */
    "skipLibCheck": true,
    "noEmit": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@utils/*": ["src/utils/*"],
      "@svg": ["src/svg/index.ts"],
      "@svg/*": ["src/svg/*"],
      "@theme/*": ["src/theme/*"]
    },

    /* Testing */
    "types": ["jest"]
  },

  "include": ["src/**/*", "index.ts", "index.tsx"],

  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/Pods"
  ]
}
